# ── Database ──────────────────────────────────────────────────────────────────
# Production (Vercel): MongoDB Atlas SRV string, e.g.
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/taprevia?retryWrites=true&w=majority
# Dev: leave as the local mongod default below.
MONGODB_URI=mongodb://localhost:27017/nfc-crm

# Explicit database name. Overrides the database path inside MONGODB_URI.
# - Vercel Preview: REQUIRED and must be the Preview database name. The app
#   fails closed at startup/build when it is missing.
# - Vercel Production: defaults to `test`; setting it explicitly is recommended.
# - Local development: optional; defaults to `taprevia_V2`.
MONGODB_DB=

# JWT signing secret. Required, min 24 chars (validated by src/lib/env.ts).
# Do NOT reuse this dev value in production — generate a fresh 64-byte value.
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Public origin used for permanent QR/NFC route URLs (qr-server.ts).
# Production: https://taprevia.com  — dev: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Preview-only QR/NFC origin approval. Leave EMPTY in Production and local dev.
# Set BOTH values to the same exact hostname in the Vercel Preview scope, e.g.
#   taprevia-crm-git-devlopment-team.vercel.app
# Requirements: VERCEL_ENV=preview, HTTPS NEXT_PUBLIC_BASE_URL, exact hostname
# match, no wildcard, no port, no credentials, no path/query. Missing values
# disable QR generation in Preview rather than emit an unsafe URL.
PREVIEW_APPROVED_HOST=
NEXT_PUBLIC_PREVIEW_APPROVED_HOST=

# WhatsApp number used by the marketing site's Chat/WhatsApp CTAs
# (src/lib/marketing/whatsapp.ts). E+164 digits with country code, no spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Server listen port (used by src/lib/mail.ts for dev reset-link URLs).
# Only needed when running on a non-default port.
PORT=3000

NODE_ENV=development

# AES-256-GCM key for encrypting tenant secrets (OpenAI API keys etc).
# Generate with: openssl rand -base64 32
# REQUIRED in production before reading any previously encrypted keys.
APP_KEY=

# ── Media storage ─────────────────────────────────────────────────────────────
# 'local' = filesystem under UPLOAD_DIR (dev/self-hosted only — Vercel's
# filesystem is non-persistent).
# 's3'    = any S3-compatible object store (Cloudflare R2 free tier).
# In production an unset MEDIA_DRIVER defaults to 's3' and REQUIRES S3_BUCKET.
MEDIA_DRIVER=local
UPLOAD_DIR=.data/uploads

# Cloudflare R2 (free tier): point S3_ENDPOINT at your R2 endpoint and use an
# R2 access key pair. Region can be 'auto'.
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Canonical AWS credential names consumed by src/lib/storage/s3.ts
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── R2 bucket CORS (required for direct browser uploads) ──────────────────────
# Allow the app origin (Vercel domain, and http://localhost:3000 in dev) with
# methods GET, PUT, HEAD; headers Content-Type, Authorization; allow all headers
# or explicitly x-amz-*. Expose ETag if you want upload read-back.

# ── Email (forgot-password reset links) ───────────────────────────────────────
# Production delivery uses Resend (https://resend.com) behind src/lib/mail.ts.
#   RESEND_API_KEY: API key from the Resend dashboard (never commit it).
#   EMAIL_FROM: the verified sender address, e.g. "Taprevia <no-reply@yourdomain.com>".
# The sending domain must be verified in Resend (DNS/DKIM/SPF) BEFORE production
# delivery works. In development no key is required — reset links are printed to
# the server console instead (see src/lib/mail.ts).
RESEND_API_KEY=
EMAIL_FROM=Taprevia <no-reply@yourdomain.com>

# ── Optional ──────────────────────────────────────────────────────────────────
# Comma-separated image hosts for next/image remotePatterns (build-time; the
# app renders media via plain <img>, so usually unset).
IMAGE_HOSTS=

# ── Review experience gates ───────────────────────────────────────────────────
# Both default OFF and require the exact string "true".
# - NEW_REVIEW_COPY_FLOW_ENABLED: the two-button customer copy experience.
# - SMART_REVIEW_ROTATION_ENABLED: rotation exclusions/tokens/recording.
# Rotation is effective only when both flags are true. Do not enable rotation in
# production until the rotation collection indexes exist (see docs/DEPLOYMENT.md).
NEW_REVIEW_COPY_FLOW_ENABLED=false
SMART_REVIEW_ROTATION_ENABLED=false

# Central ReviewSettings public integration. Default OFF: Cards configured as
# central/hybrid continue to use their legacy Card.reviewAssistant values until
# this is explicitly enabled. This is independent of the copy/rotation gates.
CENTRAL_REVIEW_PUBLIC_INTEGRATION_ENABLED=false

# Google Review Standee public review host. Default OFF: every existing
# /r/... and /qr/... Standee destination keeps its current behavior. When ON,
# eligible Google Review Standees route their existing printed QR/NFC URLs to
# the review host while preserving their own Google destination.
STANDEE_REVIEW_ASSISTANT_ENABLED=false
